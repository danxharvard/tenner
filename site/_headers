# How long browsers keep Tenner's files (Cloudflare reads this file; it isn't served). Scripts and styles are linked with
# the version (?v=…), so a new version is fetched straight away whatever this says. Pages, the service worker and
# the hourly data are always checked with the server (Cloudflare's default), so nothing here can hold back an update.
/*.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/sw.js
  ! Cache-Control
  Cache-Control: no-cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
